root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.md]
end_of_line = lf
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2
end_of_line = lf

[*.cs]
end_of_line = crlf
indent_style = space
indent_size = 4
tab_width = 4
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_prefer_braces = true:suggestion

[*.xaml]
end_of_line = crlf
indent_style = space
indent_size = 4
tab_width = 4
