<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:icons="clr-namespace:BTDeviceBatteryInfo.Services">
    <!-- Colors, radii, sizes and shadows come from Themes/*.xaml, swapped at runtime by ThemeManager. -->
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

    <Style x:Key="WidgetBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ShadcnBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ShadcnWindowCornerRadius}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShadcnBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
    </Style>
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
    </Style>

    <!-- Window surface. The shadow sits on a sibling layer so text keeps its normal rendering. -->
    <Style x:Key="ShadcnMainWindowBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ShadcnBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ShadcnWindowCornerRadius}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShadcnBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="ShadcnWindowShadow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ShadcnBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ShadcnWindowCornerRadius}" />
        <Setter Property="Effect" Value="{DynamicResource ShadcnShadowLg}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="ShadcnCardShadow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ShadcnSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ShadcnCardCornerRadius}" />
        <Setter Property="Effect" Value="{DynamicResource ShadcnShadowSm}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Type scale: 17 window title, 13 section title, 12 body, 11 caption. -->
    <Style x:Key="ShadcnMainTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
    </Style>

    <Style x:Key="ShadcnSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
    </Style>

    <Style x:Key="ShadcnMutedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedBrush}" />
    </Style>

    <Style x:Key="ShadcnCaptionText" TargetType="TextBlock" BasedOn="{StaticResource ShadcnMutedText}">
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Focus ring shown only on keyboard navigation (WPF's equivalent of :focus-visible). -->
    <Style x:Key="ShadcnFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="3" Opacity="0.5"
                            BorderBrush="{DynamicResource ShadcnRingBrush}"
                            CornerRadius="{DynamicResource ShadcnWindowCornerRadius}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShadcnButtonBase" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{DynamicResource ShadcnElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShadcnInputBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ShadcnFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ShadcnButtonCornerRadius}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource ShadcnAccentBrush}" />
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ShadcnPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ghost icon button (shadcn size-8). -->
    <Style x:Key="ShadcnIconButton" TargetType="Button" BasedOn="{StaticResource ShadcnButtonBase}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedBrush}" />
    </Style>

    <Style x:Key="LucideToolbarIcon" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{DynamicResource ShadcnMutedBrush}" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="Stroke" Value="{DynamicResource ShadcnForegroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ShadcnPrimaryButton" TargetType="Button" BasedOn="{StaticResource ShadcnButtonBase}">
        <Setter Property="Background" Value="{DynamicResource ShadcnPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnPrimaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShadcnPrimaryBrush}" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource ShadcnPrimaryHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ShadcnPrimaryHoverBrush}" />
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ShadcnPrimaryHoverBrush}" />
                <Setter Property="Opacity" Value="0.85" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- shadcn Switch / Windows 11 toggle, used for on/off options. -->
    <Style x:Key="ShadcnSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ShadcnFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track"
                                Width="{DynamicResource ShadcnSwitchWidth}" Height="{DynamicResource ShadcnSwitchHeight}"
                                CornerRadius="10" BorderThickness="1"
                                Background="{DynamicResource ShadcnSwitchTrackOffBrush}"
                                BorderBrush="{DynamicResource ShadcnSwitchTrackOffBorderBrush}"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="Thumb"
                                     Width="{DynamicResource ShadcnSwitchThumbSize}" Height="{DynamicResource ShadcnSwitchThumbSize}"
                                     Fill="{DynamicResource ShadcnSwitchThumbOffBrush}"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ShadcnPrimaryBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ShadcnPrimaryBrush}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource ShadcnSwitchThumbOnBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ShadcnAccentBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ShadcnPrimaryHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tooltip: inverted in Elegant Black (shadcn), flyout-like in System (Windows 11). -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource ShadcnTooltipBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnTooltipForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShadcnTooltipBorderBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource ShadcnControlCornerRadius}" Padding="{TemplateBinding Padding}" MaxWidth="320">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Context menu as a shadcn popover. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource ShadcnPopoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShadcnBorderBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid Margin="8,4,8,12">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ShadcnControlCornerRadius}"
                                Effect="{DynamicResource ShadcnShadowMd}" />
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ShadcnControlCornerRadius}" Padding="4" MinWidth="128">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemBorder" Background="Transparent" Padding="8,6"
                            CornerRadius="{DynamicResource ShadcnMenuItemCornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <Path x:Name="CheckMark" Grid.Column="1" Data="{x:Static icons:LucideIcons.Check}"
                                  Style="{StaticResource LucideToolbarIcon}" Width="14" Height="14" Margin="16,0,0,0"
                                  Stroke="{DynamicResource ShadcnForegroundBrush}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ShadcnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Skeleton placeholder with an opacity pulse. -->
    <Style x:Key="ShadcnSkeleton" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ShadcnAccentBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ShadcnControlCornerRadius}" />
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.9" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ShadcnExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource ShadcnMutedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderSite"
                                      Content="{TemplateBinding Header}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Background="Transparent"
                                      Foreground="{TemplateBinding Foreground}"
                                      BorderThickness="0"
                                      HorizontalContentAlignment="Stretch"
                                      FocusVisualStyle="{StaticResource ShadcnFocusVisual}"
                                      Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ShadcnControlCornerRadius}" Padding="8,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="Chevron" Data="{x:Static icons:LucideIcons.ChevronRight}"
                                                  Width="12" Height="12" Stretch="Uniform" Fill="Transparent"
                                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center" Margin="0,0,9,0">
                                                <Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform>
                                            </Path>
                                            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource ShadcnAccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="90" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
