<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Windows 11 dark appearance (Fluent radii: 4 px controls, 8 px surfaces). -->
    <SolidColorBrush x:Key="ShadcnBackgroundBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="ShadcnSurfaceBrush" Color="#FF292929" />
    <SolidColorBrush x:Key="ShadcnElevatedBrush" Color="#FF303030" />
    <SolidColorBrush x:Key="ShadcnPopoverBrush" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="ShadcnAccentBrush" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="ShadcnPressedBrush" Color="#FF343434" />
    <SolidColorBrush x:Key="ShadcnBorderBrush" Color="#FF454545" />
    <SolidColorBrush x:Key="ShadcnInputBrush" Color="#FF454545" />
    <SolidColorBrush x:Key="ShadcnForegroundBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="ShadcnMutedBrush" Color="#FFB8B8B8" />
    <SolidColorBrush x:Key="ShadcnPrimaryBrush" Color="#FF46D9D3" />
    <SolidColorBrush x:Key="ShadcnPrimaryHoverBrush" Color="#FF5FE0DB" />
    <SolidColorBrush x:Key="ShadcnPrimaryForegroundBrush" Color="#FF101010" />
    <SolidColorBrush x:Key="ShadcnRingBrush" Color="#FF46D9D3" />
    <SolidColorBrush x:Key="ShadcnSuccessBrush" Color="#FF6CCB5F" />
    <SolidColorBrush x:Key="ShadcnWarningBrush" Color="#FFFCE100" />
    <SolidColorBrush x:Key="ShadcnDestructiveBrush" Color="#FFFF99A4" />
    <SolidColorBrush x:Key="ShadcnInactiveBrush" Color="#FF8A8A8A" />
    <CornerRadius x:Key="ShadcnButtonCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ShadcnControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ShadcnBadgeCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ShadcnCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ShadcnWindowCornerRadius">8</CornerRadius>
    <SolidColorBrush x:Key="ShadcnBatteryBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="ShadcnTooltipBrush" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="ShadcnTooltipForegroundBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="ShadcnTooltipBorderBrush" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="ShadcnSwitchTrackOffBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ShadcnSwitchTrackOffBorderBrush" Color="#FF9E9E9E" />
    <SolidColorBrush x:Key="ShadcnSwitchThumbOffBrush" Color="#FFCECECE" />
    <SolidColorBrush x:Key="ShadcnSwitchThumbOnBrush" Color="#FF101010" />
    <sys:Double x:Key="ShadcnSwitchWidth">40</sys:Double>
    <sys:Double x:Key="ShadcnSwitchHeight">20</sys:Double>
    <sys:Double x:Key="ShadcnSwitchThumbSize">12</sys:Double>
    <CornerRadius x:Key="ShadcnMenuItemCornerRadius">4</CornerRadius>
    <DropShadowEffect x:Key="ShadcnShadowSm" Color="Black" BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.25" />
    <DropShadowEffect x:Key="ShadcnShadowMd" Color="Black" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.35" />
    <DropShadowEffect x:Key="ShadcnShadowLg" Color="Black" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.45" />
    <SolidColorBrush x:Key="ShadcnWidgetBrush" Color="#FF2D3037" />
    <SolidColorBrush x:Key="ShadcnWidgetHoverBrush" Color="#FF383B42" />
    <SolidColorBrush x:Key="ShadcnWidgetBorderBrush" Color="#FF4B4E54" />
    <SolidColorBrush x:Key="ShadcnWidgetForegroundBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="ShadcnWidgetTrackBrush" Color="#FF6E7177" />
    <SolidColorBrush x:Key="ShadcnWidgetRingBrush" Color="#FF6CCB5F" />
    <CornerRadius x:Key="ShadcnWidgetCornerRadius">16</CornerRadius>
    <SolidColorBrush x:Key="ShadcnWindowBackgroundBrush" Color="#FF202020" />
    <BitmapImage x:Key="ShadcnAppIconImage" UriSource="pack://application:,,,/Icon/icon-dark-128.png" />
    <BitmapImage x:Key="ShadcnAppWindowIcon" UriSource="pack://application:,,,/Icon/Icon-dark.ico" />
</ResourceDictionary>
