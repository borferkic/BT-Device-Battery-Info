<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Retro Y2K, Bubblegum palette: early-2000s OS windows, 2 px borders, square corners, hard zero-blur shadows. -->
    <SolidColorBrush x:Key="ShadcnBackgroundBrush" Color="#FFFFF5DC" />
    <SolidColorBrush x:Key="ShadcnSurfaceBrush" Color="#FFFFF5DC" />
    <SolidColorBrush x:Key="ShadcnElevatedBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ShadcnPopoverBrush" Color="#FFFFF5DC" />
    <SolidColorBrush x:Key="ShadcnAccentBrush" Color="#FFEAD9FF" />
    <SolidColorBrush x:Key="ShadcnPressedBrush" Color="#FFC8A0FF" />
    <SolidColorBrush x:Key="ShadcnBorderBrush" Color="#FF1A0A2E" />
    <SolidColorBrush x:Key="ShadcnInputBrush" Color="#FF1A0A2E" />
    <SolidColorBrush x:Key="ShadcnForegroundBrush" Color="#FF1A0A2E" />
    <!-- Darker than the palette's #6B4C6B so captions stay readable on the pink desktop. -->
    <SolidColorBrush x:Key="ShadcnMutedBrush" Color="#FF4F2F55" />
    <SolidColorBrush x:Key="ShadcnPrimaryBrush" Color="#FFFFD84D" />
    <SolidColorBrush x:Key="ShadcnPrimaryHoverBrush" Color="#FFFFE372" />
    <SolidColorBrush x:Key="ShadcnPrimaryForegroundBrush" Color="#FF1A0A2E" />
    <SolidColorBrush x:Key="ShadcnPrimaryBorderBrush" Color="#FF1A0A2E" />
    <SolidColorBrush x:Key="ShadcnPrimaryHoverBorderBrush" Color="#FF1A0A2E" />
    <SolidColorBrush x:Key="ShadcnRingBrush" Color="#FFFF3D9A" />
    <SolidColorBrush x:Key="ShadcnSuccessBrush" Color="#FF13804A" />
    <SolidColorBrush x:Key="ShadcnWarningBrush" Color="#FFB86E00" />
    <SolidColorBrush x:Key="ShadcnDestructiveBrush" Color="#FFE91E5A" />
    <SolidColorBrush x:Key="ShadcnInactiveBrush" Color="#FF9B8AA0" />
    <CornerRadius x:Key="ShadcnButtonCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="ShadcnControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="ShadcnBadgeCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="ShadcnCardCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="ShadcnWindowCornerRadius">0</CornerRadius>
    <SolidColorBrush x:Key="ShadcnBatteryBrush" Color="#FF1A0A2E" />
    <SolidColorBrush x:Key="ShadcnTooltipBrush" Color="#FFFFF5DC" />
    <SolidColorBrush x:Key="ShadcnTooltipForegroundBrush" Color="#FF1A0A2E" />
    <SolidColorBrush x:Key="ShadcnTooltipBorderBrush" Color="#FF1A0A2E" />
    <SolidColorBrush x:Key="ShadcnSwitchTrackOffBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ShadcnSwitchTrackOffBorderBrush" Color="#FF1A0A2E" />
    <SolidColorBrush x:Key="ShadcnSwitchTrackOnBorderBrush" Color="#FF1A0A2E" />
    <SolidColorBrush x:Key="ShadcnSwitchThumbOffBrush" Color="#FF1A0A2E" />
    <SolidColorBrush x:Key="ShadcnSwitchThumbOnBrush" Color="#FF1A0A2E" />
    <sys:Double x:Key="ShadcnSwitchWidth">36</sys:Double>
    <sys:Double x:Key="ShadcnSwitchHeight">18</sys:Double>
    <sys:Double x:Key="ShadcnSwitchThumbSize">10</sys:Double>
    <CornerRadius x:Key="ShadcnSwitchCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="ShadcnSwitchThumbCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="ShadcnMenuItemCornerRadius">0</CornerRadius>
    <!-- Hard offset shadows, zero blur: 3 px (cards), 4 px (menus, windows) down-right. -->
    <DropShadowEffect x:Key="ShadcnShadowSm" Color="#FF1A0A2E" BlurRadius="0" ShadowDepth="4.24" Direction="315" Opacity="1" />
    <DropShadowEffect x:Key="ShadcnShadowMd" Color="#FF1A0A2E" BlurRadius="0" ShadowDepth="5.66" Direction="315" Opacity="1" />
    <DropShadowEffect x:Key="ShadcnShadowLg" Color="#FF1A0A2E" BlurRadius="0" ShadowDepth="5.66" Direction="315" Opacity="1" />
    <SolidColorBrush x:Key="ShadcnWidgetBrush" Color="#FFFFF5DC" />
    <SolidColorBrush x:Key="ShadcnWidgetHoverBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ShadcnWidgetBorderBrush" Color="#FF1A0A2E" />
    <SolidColorBrush x:Key="ShadcnWidgetForegroundBrush" Color="#FF1A0A2E" />
    <SolidColorBrush x:Key="ShadcnWidgetTrackBrush" Color="#FFD9C7B0" />
    <SolidColorBrush x:Key="ShadcnWidgetRingBrush" Color="#FFFF3D9A" />
    <CornerRadius x:Key="ShadcnWidgetCornerRadius">0</CornerRadius>
    <sys:Double x:Key="ShadcnWidgetButtonHeight">34</sys:Double>
    <!-- Main window: pink "desktop" with a 16 px graph-paper grid; device cards float on it as small windows. -->
    <DrawingBrush x:Key="ShadcnWindowBackgroundBrush" TileMode="Tile" Stretch="None"
                  Viewport="0,0,16,16" ViewportUnits="Absolute" Viewbox="0,0,16,16" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFF85C2">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFF6FAF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,16,1" />
                            <RectangleGeometry Rect="0,0,1,16" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <BitmapImage x:Key="ShadcnAppIconImage" UriSource="pack://application:,,,/Assets/Icons/icon-light-128.png" />
    <BitmapImage x:Key="ShadcnAppWindowIcon" UriSource="pack://application:,,,/Assets/Icons/Icon-light.ico" />
    <Visibility x:Key="ShadcnLucideDeviceIconVisibility">Visible</Visibility>
    <Visibility x:Key="ShadcnSystemDeviceIconVisibility">Collapsed</Visibility>
    <!-- Opaque so the hard button shadow does not show through. -->
    <SolidColorBrush x:Key="ShadcnSuccessTintBrush" Color="#FFD5F2E0" />
    <SolidColorBrush x:Key="ShadcnSuccessTintHoverBrush" Color="#FFBFEACF" />
    <!-- Structure shared by every theme; Retro Y2K turns on the window title bar, decorations and hard button shadows. -->
    <Thickness x:Key="ShadcnBorderThickness">2</Thickness>
    <Visibility x:Key="ShadcnRetroVisibility">Visible</Visibility>
    <SolidColorBrush x:Key="ShadcnRetroMinimizeBrush" Color="#FFFFD84D" />
    <SolidColorBrush x:Key="ShadcnRetroOptionsBrush" Color="#FFC8A0FF" />
    <SolidColorBrush x:Key="ShadcnRetroCloseBrush" Color="#FFFF5B5B" />
    <SolidColorBrush x:Key="ShadcnRetroSparkleBrush" Color="#FFFF3D9A" />
    <SolidColorBrush x:Key="ShadcnTitleBarBrush" Color="#FFFFD84D" />
    <Thickness x:Key="ShadcnTitleBarBorderThickness">0,0,0,2</Thickness>
    <Thickness x:Key="ShadcnTitleBarMargin">-14,-8,-14,-8</Thickness>
    <Thickness x:Key="ShadcnMainContentMargin">14,8,14,12</Thickness>
    <Thickness x:Key="ShadcnOptionsContentMargin">14,8,14,12</Thickness>
    <Thickness x:Key="ShadcnAboutContentMargin">14,8,14,16</Thickness>
    <Thickness x:Key="ShadcnCardMargin">0,0,4,7</Thickness>
    <Thickness x:Key="ShadcnButtonPressedMargin">3,3,-3,-3</Thickness>
    <sys:Double x:Key="ShadcnMainTitleFontSize">10</sys:Double>
    <sys:Double x:Key="ShadcnWindowTitleFontSize">8</sys:Double>
    <sys:Double x:Key="ShadcnSectionTitleFontSize">8</sys:Double>
    <sys:Double x:Key="ShadcnButtonFontSize">8</sys:Double>
    <sys:Double x:Key="ShadcnCompactButtonFontSize">7</sys:Double>
    <sys:Double x:Key="ShadcnToolbarIconSize">12</sys:Double>
    <sys:Double x:Key="ShadcnIconButtonSize">26</sys:Double>
</ResourceDictionary>
