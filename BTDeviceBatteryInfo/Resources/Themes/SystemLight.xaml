<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Windows 11 light appearance (Fluent radii: 4 px controls, 8 px surfaces). -->
    <SolidColorBrush x:Key="ShadcnBackgroundBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="ShadcnSurfaceBrush" Color="#FFFBFBFB" />
    <SolidColorBrush x:Key="ShadcnElevatedBrush" Color="#FFFDFDFD" />
    <SolidColorBrush x:Key="ShadcnPopoverBrush" Color="#FFF9F9F9" />
    <SolidColorBrush x:Key="ShadcnAccentBrush" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="ShadcnPressedBrush" Color="#FFE5E5E5" />
    <SolidColorBrush x:Key="ShadcnBorderBrush" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="ShadcnInputBrush" Color="#FFD6D6D6" />
    <SolidColorBrush x:Key="ShadcnForegroundBrush" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="ShadcnMutedBrush" Color="#FF5F5F5F" />
    <SolidColorBrush x:Key="ShadcnPrimaryBrush" Color="#FF00857F" />
    <SolidColorBrush x:Key="ShadcnPrimaryHoverBrush" Color="#FF1A958F" />
    <SolidColorBrush x:Key="ShadcnPrimaryForegroundBrush" Color="#FFFDFDFD" />
    <SolidColorBrush x:Key="ShadcnRingBrush" Color="#FF00857F" />
    <SolidColorBrush x:Key="ShadcnSuccessBrush" Color="#FF0F7B0F" />
    <SolidColorBrush x:Key="ShadcnWarningBrush" Color="#FF9D5D00" />
    <SolidColorBrush x:Key="ShadcnDestructiveBrush" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="ShadcnInactiveBrush" Color="#FF8A8A8A" />
    <CornerRadius x:Key="ShadcnButtonCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ShadcnControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ShadcnBadgeCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ShadcnCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ShadcnWindowCornerRadius">8</CornerRadius>
    <SolidColorBrush x:Key="ShadcnBatteryBrush" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="ShadcnTooltipBrush" Color="#FFF9F9F9" />
    <SolidColorBrush x:Key="ShadcnTooltipForegroundBrush" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="ShadcnTooltipBorderBrush" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="ShadcnSwitchTrackOffBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ShadcnSwitchTrackOffBorderBrush" Color="#FF868686" />
    <SolidColorBrush x:Key="ShadcnSwitchThumbOffBrush" Color="#FF5F5F5F" />
    <SolidColorBrush x:Key="ShadcnSwitchThumbOnBrush" Color="#FFFDFDFD" />
    <sys:Double x:Key="ShadcnSwitchWidth">40</sys:Double>
    <sys:Double x:Key="ShadcnSwitchHeight">20</sys:Double>
    <sys:Double x:Key="ShadcnSwitchThumbSize">12</sys:Double>
    <CornerRadius x:Key="ShadcnMenuItemCornerRadius">4</CornerRadius>
    <DropShadowEffect x:Key="ShadcnShadowSm" Color="Black" BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.12" />
    <DropShadowEffect x:Key="ShadcnShadowMd" Color="Black" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.18" />
    <DropShadowEffect x:Key="ShadcnShadowLg" Color="Black" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.22" />
    <SolidColorBrush x:Key="ShadcnWidgetBrush" Color="#FFFBFBFB" />
    <SolidColorBrush x:Key="ShadcnWidgetHoverBrush" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="ShadcnWidgetBorderBrush" Color="#FFD6D6D6" />
    <SolidColorBrush x:Key="ShadcnWidgetForegroundBrush" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="ShadcnWidgetTrackBrush" Color="#FFC8C8C8" />
    <SolidColorBrush x:Key="ShadcnWidgetRingBrush" Color="#FF0F7B0F" />
    <CornerRadius x:Key="ShadcnWidgetCornerRadius">16</CornerRadius>
    <SolidColorBrush x:Key="ShadcnWindowBackgroundBrush" Color="#FFF3F3F3" />
    <BitmapImage x:Key="ShadcnAppIconImage" UriSource="pack://application:,,,/Assets/Icons/icon-light-128.png" />
    <BitmapImage x:Key="ShadcnAppWindowIcon" UriSource="pack://application:,,,/Assets/Icons/Icon-light.ico" />
    <!-- Device icons: Lucide paths in Elegant Black, Windows glyphs (Segoe Fluent Icons) in System. -->
    <Visibility x:Key="ShadcnLucideDeviceIconVisibility">Collapsed</Visibility>
    <Visibility x:Key="ShadcnSystemDeviceIconVisibility">Visible</Visibility>
</ResourceDictionary>
