<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- shadcn/ui dark tokens (zinc base color, radius 0.5rem). -->
    <SolidColorBrush x:Key="ShadcnBackgroundBrush" Color="#FF0E0E10" />
    <SolidColorBrush x:Key="ShadcnSurfaceBrush" Color="#CC0E0E10" />
    <SolidColorBrush x:Key="ShadcnElevatedBrush" Color="#FF18181B" />
    <SolidColorBrush x:Key="ShadcnPopoverBrush" Color="#FF121215" />
    <SolidColorBrush x:Key="ShadcnAccentBrush" Color="#FF27272A" />
    <SolidColorBrush x:Key="ShadcnPressedBrush" Color="#FF3F3F46" />
    <SolidColorBrush x:Key="ShadcnBorderBrush" Color="#FF27272A" />
    <SolidColorBrush x:Key="ShadcnInputBrush" Color="#FF27272A" />
    <SolidColorBrush x:Key="ShadcnForegroundBrush" Color="#FFEDEDEF" />
    <SolidColorBrush x:Key="ShadcnMutedBrush" Color="#FFA1A1AA" />
    <SolidColorBrush x:Key="ShadcnPrimaryBrush" Color="#FFEDEDEF" />
    <SolidColorBrush x:Key="ShadcnPrimaryHoverBrush" Color="#FFD8D8DC" />
    <SolidColorBrush x:Key="ShadcnPrimaryForegroundBrush" Color="#FF18181B" />
    <SolidColorBrush x:Key="ShadcnRingBrush" Color="#FFD4D4D8" />
    <SolidColorBrush x:Key="ShadcnSuccessBrush" Color="#FF22C55E" />
    <SolidColorBrush x:Key="ShadcnWarningBrush" Color="#FFEAB308" />
    <SolidColorBrush x:Key="ShadcnDestructiveBrush" Color="#FFF87171" />
    <SolidColorBrush x:Key="ShadcnInactiveBrush" Color="#FF52525B" />
    <CornerRadius x:Key="ShadcnButtonCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="ShadcnControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="ShadcnBadgeCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="ShadcnCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ShadcnWindowCornerRadius">12</CornerRadius>
    <SolidColorBrush x:Key="ShadcnBatteryBrush" Color="#FFEDEDEF" />
    <SolidColorBrush x:Key="ShadcnTooltipBrush" Color="#FFEDEDEF" />
    <SolidColorBrush x:Key="ShadcnTooltipForegroundBrush" Color="#FF121215" />
    <SolidColorBrush x:Key="ShadcnTooltipBorderBrush" Color="#FFEDEDEF" />
    <SolidColorBrush x:Key="ShadcnSwitchTrackOffBrush" Color="#FF27272A" />
    <SolidColorBrush x:Key="ShadcnSwitchTrackOffBorderBrush" Color="#FF27272A" />
    <SolidColorBrush x:Key="ShadcnSwitchThumbOffBrush" Color="#FFEDEDEF" />
    <SolidColorBrush x:Key="ShadcnSwitchThumbOnBrush" Color="#FF18181B" />
    <sys:Double x:Key="ShadcnSwitchWidth">32</sys:Double>
    <sys:Double x:Key="ShadcnSwitchHeight">18</sys:Double>
    <sys:Double x:Key="ShadcnSwitchThumbSize">14</sys:Double>
    <CornerRadius x:Key="ShadcnMenuItemCornerRadius">4</CornerRadius>
    <DropShadowEffect x:Key="ShadcnShadowSm" Color="Black" BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.3" />
    <DropShadowEffect x:Key="ShadcnShadowMd" Color="Black" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.4" />
    <DropShadowEffect x:Key="ShadcnShadowLg" Color="Black" BlurRadius="18" ShadowDepth="6" Direction="270" Opacity="0.5" />
    <SolidColorBrush x:Key="ShadcnWidgetBrush" Color="#FF121215" />
    <SolidColorBrush x:Key="ShadcnWidgetHoverBrush" Color="#FF27272A" />
    <SolidColorBrush x:Key="ShadcnWidgetBorderBrush" Color="#FF27272A" />
    <SolidColorBrush x:Key="ShadcnWidgetForegroundBrush" Color="#FFEDEDEF" />
    <SolidColorBrush x:Key="ShadcnWidgetTrackBrush" Color="#FF27272A" />
    <SolidColorBrush x:Key="ShadcnWidgetRingBrush" Color="#FFEDEDEF" />
    <CornerRadius x:Key="ShadcnWidgetCornerRadius">6</CornerRadius>
    <sys:Double x:Key="ShadcnWidgetButtonHeight">36</sys:Double>
    <!-- Main window surface: very subtle top-left to bottom-right gradient. -->
    <LinearGradientBrush x:Key="ShadcnWindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF18181B" Offset="0" />
        <GradientStop Color="#FF0E0E10" Offset="0.55" />
        <GradientStop Color="#FF0C0C0E" Offset="1" />
    </LinearGradientBrush>
    <BitmapImage x:Key="ShadcnAppIconImage" UriSource="pack://application:,,,/Assets/Icons/icon-dark-128.png" />
    <BitmapImage x:Key="ShadcnAppWindowIcon" UriSource="pack://application:,,,/Assets/Icons/Icon-dark.ico" />
    <!-- Device icons: Lucide paths in Elegant Black, Windows glyphs (Segoe Fluent Icons) in System. -->
    <Visibility x:Key="ShadcnLucideDeviceIconVisibility">Visible</Visibility>
    <Visibility x:Key="ShadcnSystemDeviceIconVisibility">Collapsed</Visibility>
    <SolidColorBrush x:Key="ShadcnSuccessTintBrush" Color="#2622C55E" />
    <SolidColorBrush x:Key="ShadcnSuccessTintHoverBrush" Color="#4022C55E" />
</ResourceDictionary>
