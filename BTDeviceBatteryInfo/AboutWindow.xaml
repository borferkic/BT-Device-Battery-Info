<Window x:Class="BTDeviceBatteryInfo.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:BTDeviceBatteryInfo.Services"
        Title="About BT Device Battery Info"
        Icon="{DynamicResource ShadcnAppWindowIcon}"
        Width="424" Height="554"
        MinWidth="424" MaxWidth="424"
        MinHeight="554" MaxHeight="554"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}">
    <Grid Margin="12">
    <Border Style="{StaticResource ShadcnWindowShadow}"/>
    <Border Style="{StaticResource ShadcnMainWindowBorder}" Padding="24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="DragWindow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="About" Style="{StaticResource ShadcnMainTitle}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" ToolTip="Close" Style="{StaticResource ShadcnIconButton}" Click="Close_Click">
                    <Path Data="{x:Static icons:LucideIcons.Close}" Style="{StaticResource LucideToolbarIcon}" />
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,24,0,0">
                <Image Source="{DynamicResource ShadcnAppIconImage}" Width="76" Height="76" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="BT Device Battery Info" Foreground="{DynamicResource ShadcnForegroundBrush}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Version 0.20" Foreground="{DynamicResource ShadcnMutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Text="Quickly check your Bluetooth devices and review their connection status and battery level from a simple, unobtrusive widget."
                           Foreground="{DynamicResource ShadcnMutedBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <StackPanel Width="76">
                        <Border Width="28" Height="28" Background="{DynamicResource ShadcnElevatedBrush}" BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShadcnControlCornerRadius}" HorizontalAlignment="Center">
                            <Path Data="{x:Static icons:LucideIcons.Instagram}" Style="{StaticResource LucideToolbarIcon}" Width="15" Height="15" Stroke="{DynamicResource ShadcnForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Margin="0,5,0,0">
                            <Hyperlink NavigateUri="https://www.instagram.com/borissdk/" RequestNavigate="OpenLink_Click" Foreground="{DynamicResource ShadcnForegroundBrush}">Instagram</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Width="76">
                        <Border Width="28" Height="28" Background="{DynamicResource ShadcnElevatedBrush}" BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShadcnControlCornerRadius}" HorizontalAlignment="Center">
                            <Path Data="{x:Static icons:LucideIcons.Twitch}" Style="{StaticResource LucideToolbarIcon}" Width="15" Height="15" Stroke="{DynamicResource ShadcnForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Margin="0,5,0,0">
                            <Hyperlink NavigateUri="https://www.twitch.tv/borizillaTV" RequestNavigate="OpenLink_Click" Foreground="{DynamicResource ShadcnForegroundBrush}">Twitch</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Width="76">
                        <Border Width="28" Height="28" Background="{DynamicResource ShadcnElevatedBrush}" BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShadcnControlCornerRadius}" HorizontalAlignment="Center">
                            <Path Data="{x:Static icons:LucideIcons.LinkedIn}" Style="{StaticResource LucideToolbarIcon}" Width="15" Height="15" Stroke="{DynamicResource ShadcnForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Margin="0,5,0,0">
                            <Hyperlink NavigateUri="https://www.linkedin.com/in/borissdk/" RequestNavigate="OpenLink_Click" Foreground="{DynamicResource ShadcnForegroundBrush}">LinkedIn</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="You can support my work through PayPal or Patreon." Foreground="{DynamicResource ShadcnMutedBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <StackPanel Width="76">
                        <Border Width="28" Height="28" Background="{DynamicResource ShadcnElevatedBrush}" BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShadcnControlCornerRadius}" HorizontalAlignment="Center">
                            <Path Data="{x:Static icons:LucideIcons.PayPal}" Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource ShadcnForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Margin="0,5,0,0">
                            <Hyperlink NavigateUri="https://paypal.me/borissdk" RequestNavigate="OpenLink_Click" Foreground="{DynamicResource ShadcnForegroundBrush}">PayPal</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Width="76">
                        <Border Width="28" Height="28" Background="{DynamicResource ShadcnElevatedBrush}" BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShadcnControlCornerRadius}" HorizontalAlignment="Center">
                            <Path Data="{x:Static icons:LucideIcons.Patreon}" Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource ShadcnForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Margin="0,5,0,0">
                            <Hyperlink NavigateUri="https://patreon.com/borissdk" RequestNavigate="OpenLink_Click" Foreground="{DynamicResource ShadcnForegroundBrush}">Patreon</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="3">
                <TextBlock Text="© 2026 Boris SdK" Foreground="{DynamicResource ShadcnMutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <Button Content="Close" Style="{StaticResource ShadcnButtonBase}" HorizontalAlignment="Center" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Window>
