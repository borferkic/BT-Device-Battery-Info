<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>BTDeviceBatteryInfo</RootNamespace>
    <AssemblyName>BTDeviceBatteryInfo</AssemblyName>
    <Product>BT Device Battery Info</Product>
    <Description>Widget para consultar el estado y la batería de dispositivos Bluetooth en Windows.</Description>
    <Copyright>Boris SdK</Copyright>
    <Version>0.19</Version>
    <ApplicationIcon>Icon/Icon-dark.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="validation/**/*.cs" />
    <Resource Include="Icon.ico" />
    <Resource Include="Icon/Icon-dark.ico" />
    <Resource Include="Icon/icon-dark-128.png" />
    <Resource Include="Icon/Icon-light.ico" />
    <Resource Include="Icon/icon-light-128.png" />
    <Resource Include="avatarapp.png" />
    <Resource Include="Resources/MaterialSymbolsRounded.ttf" />
    <Resource Include="Resources/GeistSans.ttf" />
    <Content Include="Resources/MaterialSymbols-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Resources/Lucide-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Resources/Geist-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
