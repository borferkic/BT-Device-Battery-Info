<Window x:Class="BTDeviceBatteryInfo.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:BTDeviceBatteryInfo.Services"
        Title="Options" Icon="Icon.ico" Width="420" Height="600"
        MinWidth="420" MaxWidth="420" MinHeight="600" MaxHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        FontFamily="{DynamicResource AppFontFamily}">
    <Border Background="{DynamicResource ShadcnBackgroundBrush}"
            BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="DragWindow">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Options" Style="{StaticResource ShadcnMainTitle}"/>
                    <TextBlock Text="Customize startup, taskbar and appearance" Style="{StaticResource ShadcnMutedText}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" ToolTip="Close" Style="{StaticResource ShadcnIconButton}" Click="Cancel_Click">
                    <Path Data="{x:Static icons:LucideIcons.Close}" Style="{StaticResource LucideToolbarIcon}" />
                </Button>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,20,0,12">
                <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start with Windows" Foreground="{DynamicResource ShadcnForegroundBrush}" FontSize="13" Margin="2,0,0,17"/>
                <CheckBox x:Name="TaskbarWidgetCheckBox" Content="Show compact taskbar widget" Foreground="{DynamicResource ShadcnForegroundBrush}" FontSize="13" Margin="2,0,0,20"/>
                <TextBlock Text="Theme" Style="{StaticResource ShadcnSectionTitle}" FontSize="13" Margin="0,0,0,8"/>
                <ComboBox x:Name="ThemeComboBox" Height="36" FontSize="13" Padding="8,5"
                          Background="#FFF4F4F5" Foreground="#FF09090B"
                          BorderBrush="{DynamicResource ShadcnBorderBrush}" SelectionChanged="ThemeComboBox_SelectionChanged">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="#FF09090B"/>
                            <Setter Property="Background" Value="#FFF4F4F5"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBoxItem Content="System"/>
                    <ComboBoxItem Content="Elegant Black"/>
                </ComboBox>
                <StackPanel HorizontalAlignment="Center" Margin="0,145,0,0">
                    <Path Data="{x:Static icons:LucideIcons.Info}" Width="20" Height="20" Stretch="Uniform"
                          Stroke="{DynamicResource ShadcnMutedBrush}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Fill="Transparent" HorizontalAlignment="Center"/>
                    <Button Content="About" Style="{StaticResource ShadcnButtonBase}" Width="92" Margin="0,7,0,0" Click="About_Click"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource ShadcnButtonBase}" MinWidth="82" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Save" Style="{StaticResource ShadcnPrimaryButton}" MinWidth="82" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
