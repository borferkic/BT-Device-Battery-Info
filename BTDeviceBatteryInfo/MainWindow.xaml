<Window x:Class="BTDeviceBatteryInfo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:BTDeviceBatteryInfo.Models"
        xmlns:icons="clr-namespace:BTDeviceBatteryInfo.Services"
        Title="BT Device Battery Info"
        Icon="Icon.ico"
        Width="460" Height="320"
        MinWidth="460" MaxWidth="460"
        MinHeight="320"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource AppFontFamily}">
    <Window.Resources>
        <DataTemplate x:Key="BluetoothDeviceTemplate">
            <Border Background="{DynamicResource ShadcnSurfaceBrush}"
                    BorderBrush="{DynamicResource ShadcnBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10"
                    Margin="0,0,0,8"
                    MinHeight="64">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" Background="{DynamicResource ShadcnElevatedBrush}" CornerRadius="9" VerticalAlignment="Center">
                        <Path x:Name="DeviceIcon"
                              Data="{x:Static icons:LucideIcons.Headphones}"
                              Width="21" Height="21" Stretch="Uniform"
                              Stroke="{DynamicResource ShadcnForegroundBrush}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{DynamicResource ShadcnForegroundBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Ellipse Width="6" Height="6" Fill="{Binding ConnectionBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionText}"
                                       Foreground="{DynamicResource ShadcnMutedBrush}"
                                       FontSize="11"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BatteryText}"
                                   Foreground="{Binding BatteryBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Right" />
                        <Grid Width="23" Height="12" Margin="0,5,0,0" HorizontalAlignment="Right" ToolTip="{Binding BatteryText}">
                            <Border Width="19" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center" BorderBrush="{Binding BatteryBrush}" BorderThickness="1" CornerRadius="2">
                                <Border Width="{Binding BatteryFillWidth}" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Background="{Binding BatteryBrush}" CornerRadius="1" />
                            </Border>
                            <Border Width="2" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{Binding BatteryBrush}" CornerRadius="0,1,1,0" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Category}" Value="{x:Static models:BluetoothDeviceCategory.Headphones}">
                    <Setter TargetName="DeviceIcon" Property="Data" Value="{x:Static icons:LucideIcons.Headphones}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="{x:Static models:BluetoothDeviceCategory.Keyboard}">
                    <Setter TargetName="DeviceIcon" Property="Data" Value="{x:Static icons:LucideIcons.Keyboard}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="{x:Static models:BluetoothDeviceCategory.Mouse}">
                    <Setter TargetName="DeviceIcon" Property="Data" Value="{x:Static icons:LucideIcons.Mouse}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="{x:Static models:BluetoothDeviceCategory.GameController}">
                    <Setter TargetName="DeviceIcon" Property="Data" Value="{x:Static icons:LucideIcons.Gamepad}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Border Style="{StaticResource ShadcnMainWindowBorder}">
        <Grid Margin="18,15,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="DragWindow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" Background="{DynamicResource ShadcnElevatedBrush}" CornerRadius="9" VerticalAlignment="Center">
                    <Image Source="Icon.png" Width="25" Height="25" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="BT Device Battery Info" Style="{StaticResource ShadcnMainTitle}" />
                    <TextBlock Text="Bluetooth device overview" Style="{StaticResource ShadcnMutedText}" FontSize="10" Margin="0,1,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button ToolTip="Minimize to tray" Style="{StaticResource ShadcnIconButton}" Click="Minimize_Click">
                        <Path Data="{x:Static icons:LucideIcons.Minimize}" Style="{StaticResource LucideToolbarIcon}" />
                    </Button>
                    <Button ToolTip="Options" Style="{StaticResource ShadcnIconButtonNoFocusRing}" Click="Options_Click">
                        <Path Data="{x:Static icons:LucideIcons.Settings}" Style="{StaticResource LucideToolbarIcon}" />
                    </Button>
                    <Button ToolTip="Exit" Style="{StaticResource ShadcnIconButton}" Click="Exit_Click">
                        <Path Data="{x:Static icons:LucideIcons.Close}" Style="{StaticResource LucideToolbarIcon}" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,16,0,0" Padding="0,0,0,12" BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Your devices" Style="{StaticResource ShadcnSectionTitle}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="{DynamicResource ShadcnElevatedBrush}" BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,4">
                        <TextBlock Text="{Binding DeviceCountText}" Foreground="{DynamicResource ShadcnMutedBrush}" FontSize="10" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,10,0,4">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Background="{DynamicResource ShadcnElevatedBrush}" BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,8" Visibility="{Binding RefreshStatusVisibility}">
                            <TextBlock Text="{Binding RefreshStatus}" Style="{StaticResource ShadcnMutedText}" TextWrapping="Wrap" />
                        </Border>
                        <Border Background="{DynamicResource ShadcnElevatedBrush}" BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8" Visibility="{Binding DeviceListMessageVisibility}">
                            <TextBlock Text="{Binding DeviceListMessage}" Style="{StaticResource ShadcnMutedText}" TextWrapping="Wrap" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding ConnectedDevices}" ItemTemplate="{StaticResource BluetoothDeviceTemplate}" />
                        <Expander Style="{StaticResource ShadcnExpander}"
                                  IsExpanded="{Binding IsDisconnectedDevicesExpanded, Mode=TwoWay}"
                                  Visibility="{Binding DisconnectedDevicesVisibility}"
                                  HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Disconnected devices" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" MinWidth="24" Height="20" Padding="6,1" Background="{DynamicResource ShadcnElevatedBrush}" BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="1" CornerRadius="10">
                                        <TextBlock Text="{Binding DisconnectedDeviceCountText}" Foreground="{DynamicResource ShadcnForegroundBrush}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding DisconnectedDevices}" ItemTemplate="{StaticResource BluetoothDeviceTemplate}" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
                <Grid Background="{DynamicResource ShadcnBackgroundBrush}" Visibility="{Binding LoadingVisibility}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="34" Height="34" Stroke="{DynamicResource ShadcnRingBrush}" StrokeThickness="3" StrokeDashArray="12,6" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
                            <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="Loading devices..." Style="{StaticResource ShadcnMutedText}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="3" Margin="0,9,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="22" Background="{DynamicResource ShadcnElevatedBrush}" BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="BETA" Foreground="{DynamicResource ShadcnMutedBrush}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Button Grid.Column="1" Content="Refresh now" Style="{StaticResource ShadcnPrimaryButton}" MinWidth="104" Click="RefreshNow_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
