<Window x:Class="BTDeviceBatteryInfo.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:BTDeviceBatteryInfo.Services"
        Title="{DynamicResource Str.Options.Title}" Icon="{DynamicResource ShadcnAppWindowIcon}" Width="444" SizeToContent="Height"
        MinWidth="444" MaxWidth="444"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        FontFamily="{DynamicResource AppFontFamily}">
    <Window.Resources>
        <Style x:Key="OptionsPickerItemStyle" TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                CornerRadius="{DynamicResource ShadcnMenuItemCornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                                <Path x:Name="CheckMark" Grid.Column="1" Data="{x:Static icons:LucideIcons.Check}"
                                      Style="{StaticResource LucideToolbarIcon}" Width="14" Height="14" Margin="12,0,0,0"
                                      Stroke="{DynamicResource ShadcnForegroundBrush}" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ShadcnAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OptionsPickerStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ShadcnFocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ShadcnInputBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource OptionsPickerItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{DynamicResource ShadcnControlCornerRadius}">
                                            <Grid>
                                                <ContentPresenter IsHitTestVisible="False" Margin="12,0,32,0"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                                  TextElement.Foreground="{DynamicResource ShadcnForegroundBrush}"
                                                                  VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                <Path Data="{x:Static icons:LucideIcons.ChevronDown}" Width="16" Height="16" Stretch="Uniform" Opacity="0.5"
                                                      Stroke="{DynamicResource ShadcnForegroundBrush}" StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource ShadcnAccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource ShadcnAccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" HorizontalOffset="-8" VerticalOffset="0" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Grid Margin="8,4,8,12" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{DynamicResource ShadcnPopoverBrush}" CornerRadius="{DynamicResource ShadcnControlCornerRadius}"
                                            Effect="{DynamicResource ShadcnShadowMd}"/>
                                    <Border Background="{DynamicResource ShadcnPopoverBrush}"
                                            BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="1"
                                            CornerRadius="{DynamicResource ShadcnControlCornerRadius}">
                                        <ScrollViewer Margin="4" CanContentScroll="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
    <Border Style="{StaticResource ShadcnWindowShadow}"/>
    <Border Style="{StaticResource ShadcnMainWindowBorder}">
        <Grid Margin="16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="DragWindow">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Options.Title}" Style="{StaticResource ShadcnMainTitle}"/>
                    <TextBlock Text="{DynamicResource Str.Options.Subtitle}" Style="{StaticResource ShadcnMutedText}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" ToolTip="{DynamicResource Str.Options.Close}" Style="{StaticResource ShadcnIconButton}" Click="Cancel_Click">
                    <Path Data="{x:Static icons:LucideIcons.Close}" Style="{StaticResource LucideToolbarIcon}" />
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" Margin="0,12,0,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <CheckBox x:Name="StartWithWindowsCheckBox" Content="{DynamicResource Str.Options.StartWithWindows}" Style="{StaticResource ShadcnSwitch}" Margin="4,2,0,8" HorizontalAlignment="Left"/>
                <Grid Margin="4,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="TaskbarWidgetCheckBox" Content="{DynamicResource Str.Options.TaskbarWidget}" Style="{StaticResource ShadcnSwitch}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <ComboBox x:Name="TaskbarPositionComboBox" Grid.Column="1" Width="84" Style="{StaticResource OptionsPickerStyle}"
                              ToolTip="{DynamicResource Str.Options.TaskbarPosition}" IsEnabled="{Binding IsChecked, ElementName=TaskbarWidgetCheckBox}">
                        <ComboBoxItem Content="{DynamicResource Str.Options.PositionLeft}" Tag="Left" Style="{StaticResource OptionsPickerItemStyle}"/>
                        <ComboBoxItem Content="{DynamicResource Str.Options.PositionRight}" Tag="Right" Style="{StaticResource OptionsPickerItemStyle}"/>
                    </ComboBox>
                </Grid>
                <Grid Margin="4,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="LowBatteryCheckBox" Content="{DynamicResource Str.Options.LowBatteryNotifications}" Style="{StaticResource ShadcnSwitch}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <ComboBox x:Name="LowBatteryThresholdComboBox" Grid.Column="1" Width="84" Style="{StaticResource OptionsPickerStyle}"
                              ToolTip="{DynamicResource Str.Options.LowBatteryThreshold}" IsEnabled="{Binding IsChecked, ElementName=LowBatteryCheckBox}"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="{DynamicResource Str.Options.Theme}" Style="{StaticResource ShadcnSectionTitle}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ThemeComboBox" Style="{StaticResource OptionsPickerStyle}"
                                  SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="System" Tag="System"/>
                            <ComboBoxItem Content="Elegant Black" Tag="Elegant Black"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{DynamicResource Str.Options.Language}" Style="{StaticResource ShadcnSectionTitle}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="LanguageComboBox" Style="{StaticResource OptionsPickerStyle}"
                                  SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBoxItem Content="English" Tag="en"/>
                            <ComboBoxItem Content="Español" Tag="es"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{DynamicResource Str.Options.TaskbarDevices}" Style="{StaticResource ShadcnSectionTitle}" Margin="0,12,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <Path Data="{x:Static icons:LucideIcons.Headphones}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource ShadcnMutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" VerticalAlignment="Center" Visibility="{DynamicResource ShadcnLucideDeviceIconVisibility}"/>
                            <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource SystemIconFontFamily}" FontSize="14" Foreground="{DynamicResource ShadcnMutedBrush}" VerticalAlignment="Center" Visibility="{DynamicResource ShadcnSystemDeviceIconVisibility}"/>
                            <TextBlock Text="{DynamicResource Str.Options.Headphones}" Style="{StaticResource ShadcnCaptionText}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox x:Name="HeadphonesComboBox" Style="{StaticResource OptionsPickerStyle}" ToolTip="{DynamicResource Str.Options.ChooseHeadphones}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <Path Data="{x:Static icons:LucideIcons.Keyboard}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource ShadcnMutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" VerticalAlignment="Center" Visibility="{DynamicResource ShadcnLucideDeviceIconVisibility}"/>
                            <TextBlock Text="&#xE765;" FontFamily="{StaticResource SystemIconFontFamily}" FontSize="14" Foreground="{DynamicResource ShadcnMutedBrush}" VerticalAlignment="Center" Visibility="{DynamicResource ShadcnSystemDeviceIconVisibility}"/>
                            <TextBlock Text="{DynamicResource Str.Options.Keyboard}" Style="{StaticResource ShadcnCaptionText}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox x:Name="KeyboardComboBox" Style="{StaticResource OptionsPickerStyle}" ToolTip="{DynamicResource Str.Options.ChooseKeyboard}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,8,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <Path Data="{x:Static icons:LucideIcons.Gamepad}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource ShadcnMutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" VerticalAlignment="Center" Visibility="{DynamicResource ShadcnLucideDeviceIconVisibility}"/>
                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource SystemIconFontFamily}" FontSize="14" Foreground="{DynamicResource ShadcnMutedBrush}" VerticalAlignment="Center" Visibility="{DynamicResource ShadcnSystemDeviceIconVisibility}"/>
                            <TextBlock Text="{DynamicResource Str.Options.Controller}" Style="{StaticResource ShadcnCaptionText}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox x:Name="GameControllerComboBox" Style="{StaticResource OptionsPickerStyle}" ToolTip="{DynamicResource Str.Options.ChooseController}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <Path Data="{x:Static icons:LucideIcons.Mouse}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource ShadcnMutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" VerticalAlignment="Center" Visibility="{DynamicResource ShadcnLucideDeviceIconVisibility}"/>
                            <TextBlock Text="&#xE962;" FontFamily="{StaticResource SystemIconFontFamily}" FontSize="14" Foreground="{DynamicResource ShadcnMutedBrush}" VerticalAlignment="Center" Visibility="{DynamicResource ShadcnSystemDeviceIconVisibility}"/>
                            <TextBlock Text="{DynamicResource Str.Options.Mouse}" Style="{StaticResource ShadcnCaptionText}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox x:Name="MouseComboBox" Style="{StaticResource OptionsPickerStyle}" ToolTip="{DynamicResource Str.Options.ChooseMouse}"/>
                    </StackPanel>
                </Grid>
                <Button Style="{StaticResource ShadcnButtonBase}" HorizontalAlignment="Center" Margin="0,12,0,2" Click="About_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{x:Static icons:LucideIcons.Info}" Width="15" Height="15" Stretch="Uniform"
                              Stroke="{DynamicResource ShadcnMutedBrush}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Margin="0,0,7,0"/>
                        <TextBlock Text="{DynamicResource Str.Options.About}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Str.Options.Cancel}" Style="{StaticResource ShadcnButtonBase}" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="{DynamicResource Str.Options.Save}" Style="{StaticResource ShadcnPrimaryButton}" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Window>
