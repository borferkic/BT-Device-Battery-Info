<Window x:Class="BTDeviceBatteryInfo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:BTDeviceBatteryInfo.Models"
        xmlns:icons="clr-namespace:BTDeviceBatteryInfo.Services"
        Title="BT Device Battery Info"
        Icon="{DynamicResource ShadcnAppWindowIcon}"
        Width="484" Height="344"
        MinWidth="484" MaxWidth="484"
        MinHeight="344"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource AppFontFamily}">
    <Window.Resources>
        <DataTemplate x:Key="BluetoothDeviceTemplate">
            <Grid Margin="0,0,0,8">
            <Border Style="{StaticResource ShadcnCardShadow}" />
            <Border Background="{DynamicResource ShadcnSurfaceBrush}"
                    BorderBrush="{DynamicResource ShadcnBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ShadcnCardCornerRadius}"
                    Padding="12,10"
                    MinHeight="64">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" Background="{DynamicResource ShadcnElevatedBrush}" CornerRadius="{DynamicResource ShadcnControlCornerRadius}" VerticalAlignment="Center">
                        <Grid>
                        <Path x:Name="DeviceIcon"
                              Data="{x:Static icons:LucideIcons.Headphones}"
                              Width="21" Height="21" Stretch="Uniform"
                              Stroke="{DynamicResource ShadcnForegroundBrush}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="{DynamicResource ShadcnLucideDeviceIconVisibility}" />
                        <TextBlock x:Name="DeviceGlyph" Text="&#xE7F6;" FontFamily="{StaticResource SystemIconFontFamily}" FontSize="20"
                                   Foreground="{DynamicResource ShadcnForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{DynamicResource ShadcnSystemDeviceIconVisibility}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{DynamicResource ShadcnForegroundBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Ellipse x:Name="ConnectionDot" Width="6" Height="6" Fill="{DynamicResource ShadcnInactiveBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionText}"
                                       Foreground="{DynamicResource ShadcnMutedBrush}"
                                       FontSize="11"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="BatteryLabel" Text="{Binding BatteryText}"
                                   Foreground="{DynamicResource ShadcnMutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Right" />
                        <Grid Width="23" Height="12" Margin="0,5,0,0" HorizontalAlignment="Right" ToolTip="{Binding BatteryText}">
                            <Border x:Name="BatteryShell" Width="19" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource ShadcnElevatedBrush}" BorderBrush="{DynamicResource ShadcnMutedBrush}" BorderThickness="1" CornerRadius="2">
                                <Border x:Name="BatteryFill" Width="{Binding BatteryFillWidth}" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0" Background="{DynamicResource ShadcnBatteryBrush}" CornerRadius="1" />
                            </Border>
                            <Border x:Name="BatteryTip" Width="2" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource ShadcnMutedBrush}" CornerRadius="0,1,1,0" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter TargetName="ConnectionDot" Property="Fill" Value="{DynamicResource ShadcnSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasBattery}" Value="True">
                    <Setter TargetName="BatteryLabel" Property="Foreground" Value="{DynamicResource ShadcnForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBatteryLow}" Value="True">
                    <Setter TargetName="BatteryLabel" Property="Foreground" Value="{DynamicResource ShadcnDestructiveBrush}" />
                    <Setter TargetName="BatteryFill" Property="Background" Value="{DynamicResource ShadcnDestructiveBrush}" />
                    <Setter TargetName="BatteryShell" Property="BorderBrush" Value="{DynamicResource ShadcnDestructiveBrush}" />
                    <Setter TargetName="BatteryTip" Property="Background" Value="{DynamicResource ShadcnDestructiveBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="{x:Static models:BluetoothDeviceCategory.Headphones}">
                    <Setter TargetName="DeviceIcon" Property="Data" Value="{x:Static icons:LucideIcons.Headphones}" />
                    <Setter TargetName="DeviceGlyph" Property="Text" Value="&#xE7F6;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="{x:Static models:BluetoothDeviceCategory.Keyboard}">
                    <Setter TargetName="DeviceIcon" Property="Data" Value="{x:Static icons:LucideIcons.Keyboard}" />
                    <Setter TargetName="DeviceGlyph" Property="Text" Value="&#xE765;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="{x:Static models:BluetoothDeviceCategory.Mouse}">
                    <Setter TargetName="DeviceIcon" Property="Data" Value="{x:Static icons:LucideIcons.Mouse}" />
                    <Setter TargetName="DeviceGlyph" Property="Text" Value="&#xE962;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="{x:Static models:BluetoothDeviceCategory.GameController}">
                    <Setter TargetName="DeviceIcon" Property="Data" Value="{x:Static icons:LucideIcons.Gamepad}" />
                    <Setter TargetName="DeviceGlyph" Property="Text" Value="&#xE7FC;" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="12">
    <Border Style="{StaticResource ShadcnWindowShadow}" Background="{DynamicResource ShadcnWindowBackgroundBrush}" />
    <Border Style="{StaticResource ShadcnMainWindowBorder}" Background="{DynamicResource ShadcnWindowBackgroundBrush}">
        <Grid Margin="18,15,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="DragWindow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="{DynamicResource ShadcnAppIconImage}" Width="34" Height="34" Stretch="Uniform" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="BT Device Battery Info" Style="{StaticResource ShadcnMainTitle}" />
                    <TextBlock Text="{DynamicResource Str.Main.Subtitle}" Style="{StaticResource ShadcnCaptionText}" Margin="0,1,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button ToolTip="{DynamicResource Str.Main.MinimizeToTray}" Style="{StaticResource ShadcnIconButton}" Click="Minimize_Click">
                        <Path Data="{x:Static icons:LucideIcons.Minimize}" Style="{StaticResource LucideToolbarIcon}" />
                    </Button>
                    <Button ToolTip="{DynamicResource Str.Main.Options}" Style="{StaticResource ShadcnIconButton}" Click="Options_Click">
                        <Path Data="{x:Static icons:LucideIcons.Settings}" Style="{StaticResource LucideToolbarIcon}" />
                    </Button>
                    <Button ToolTip="{DynamicResource Str.Main.Exit}" Style="{StaticResource ShadcnIconButton}" Click="Exit_Click">
                        <Path Data="{x:Static icons:LucideIcons.Close}" Style="{StaticResource LucideToolbarIcon}" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,16,0,0" Padding="0,0,0,12" BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str.Main.YourDevices}" Style="{StaticResource ShadcnSectionTitle}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="{DynamicResource ShadcnElevatedBrush}" BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShadcnBadgeCornerRadius}" Padding="8,4">
                        <TextBlock Text="{Binding DeviceCountText}" Style="{StaticResource ShadcnCaptionText}" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,10,0,4">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LoadingVisibility}" Value="Visible">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBluetoothUnavailable}" Value="True">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShadcnCardCornerRadius}" Padding="16,18" Margin="0,0,0,8" Visibility="{Binding DeviceListMessageVisibility}">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="36" Height="36" Background="{DynamicResource ShadcnElevatedBrush}" CornerRadius="{DynamicResource ShadcnControlCornerRadius}" HorizontalAlignment="Center">
                                    <Path Data="{x:Static icons:LucideIcons.Bluetooth}" Style="{StaticResource LucideToolbarIcon}" Width="18" Height="18" Stroke="{DynamicResource ShadcnForegroundBrush}" />
                                </Border>
                                <TextBlock Text="{Binding DeviceListMessage}" Style="{StaticResource ShadcnMutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" MaxWidth="320" />
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding ConnectedDevices}" ItemTemplate="{StaticResource BluetoothDeviceTemplate}" />
                        <Expander Style="{StaticResource ShadcnExpander}"
                                  IsExpanded="{Binding IsDisconnectedDevicesExpanded, Mode=TwoWay}"
                                  Visibility="{Binding DisconnectedDevicesVisibility}"
                                  HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Str.Main.DisconnectedDevices}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" MinWidth="24" Height="20" Padding="6,1" Background="{DynamicResource ShadcnElevatedBrush}" BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShadcnBadgeCornerRadius}">
                                        <TextBlock Text="{Binding DisconnectedDeviceCountText}" Style="{StaticResource ShadcnCaptionText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding DisconnectedDevices}" ItemTemplate="{StaticResource BluetoothDeviceTemplate}" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
                <Grid Background="Transparent" Visibility="{Binding LoadingVisibility}">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShadcnCardCornerRadius}" Padding="12,10" Margin="0,0,0,8" MinHeight="64">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ShadcnSkeleton}" Width="36" Height="36" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                    <Border Style="{StaticResource ShadcnSkeleton}" Height="12" Width="150" HorizontalAlignment="Left" />
                                    <Border Style="{StaticResource ShadcnSkeleton}" Height="10" Width="72" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource ShadcnSkeleton}" Width="44" Height="10" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShadcnCardCornerRadius}" Padding="12,10" Margin="0,0,0,8" MinHeight="64">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ShadcnSkeleton}" Width="36" Height="36" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                    <Border Style="{StaticResource ShadcnSkeleton}" Height="12" Width="110" HorizontalAlignment="Left" />
                                    <Border Style="{StaticResource ShadcnSkeleton}" Height="10" Width="72" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource ShadcnSkeleton}" Width="44" Height="10" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Path Data="{x:Static icons:LucideIcons.LoaderCircle}" Style="{StaticResource LucideToolbarIcon}" Width="14" Height="14" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>
                            <TextBlock Text="{DynamicResource Str.Main.Loading}" Style="{StaticResource ShadcnCaptionText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Border Visibility="{Binding BluetoothUnavailableVisibility}" BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource ShadcnCardCornerRadius}" Padding="16,20" VerticalAlignment="Top">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="40" Height="40" Background="{DynamicResource ShadcnElevatedBrush}" CornerRadius="{DynamicResource ShadcnControlCornerRadius}" HorizontalAlignment="Center">
                            <Path Data="{x:Static icons:LucideIcons.BluetoothOff}" Style="{StaticResource LucideToolbarIcon}" Width="20" Height="20" Stroke="{DynamicResource ShadcnForegroundBrush}" />
                        </Border>
                        <TextBlock Text="{Binding BluetoothUnavailableTitle}" Style="{StaticResource ShadcnSectionTitle}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding BluetoothUnavailableDescription}" Style="{StaticResource ShadcnMutedText}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Button Content="{DynamicResource Str.Radio.TurnOn}" Style="{StaticResource ShadcnPrimaryButton}" Command="{Binding TurnOnBluetoothCommand}"
                                    Visibility="{Binding TurnOnBluetoothVisibility}" IsEnabled="{Binding CanTurnOnBluetooth}" Margin="0,0,8,0" />
                            <Button Content="{DynamicResource Str.Radio.Settings}" Style="{StaticResource ShadcnButtonBase}" Command="{Binding OpenBluetoothSettingsCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding BluetoothActionStatus}" Visibility="{Binding BluetoothActionStatusVisibility}" Style="{StaticResource ShadcnCaptionText}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0,9,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="22" Background="{DynamicResource ShadcnElevatedBrush}" BorderBrush="{DynamicResource ShadcnBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShadcnBadgeCornerRadius}" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Str.Main.Beta}" Foreground="{DynamicResource ShadcnMutedBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Button Grid.Column="1" Content="{Binding RefreshButtonText}" IsEnabled="{Binding CanRefresh}" Style="{StaticResource ShadcnPrimaryButton}" Click="RefreshNow_Click" />
            </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>
